							<left>314</left>
							<top>16</top>
							<width>308</width>
							<height>38</height>
							<font>font27</font>
							<textcolor>rs_text</textcolor>
							<label>$PARAM[label]</label>
							<visible>!$EXP[rs_is_episode] | String.IsEmpty(ListItem.TVShowTitle)</visible>
