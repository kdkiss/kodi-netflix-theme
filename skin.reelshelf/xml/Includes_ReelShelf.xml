					<onclick condition="$PARAM[library] + !String.IsEmpty(ListItem.DBID) + ![$PARAM[resume] + ListItem.IsResumable]">Action(Info)</onclick>
					<itemlayout width="304" height="180">
						<include content="RS_CardBody">
							<param name="label" value="$PARAM[label]" />
