	<include name="RS_ShelfLinks">
		<param name="id" />
		<param name="key" />
		<definition>
			<content>
				<item>
					<label>$LOCALIZE[31730]</label>
					<visible>!Container($PARAM[id]).IsUpdating</visible>
					<icon>icons/sidemenu/addons.png</icon>
					<property name="rs_shelf_action">true</property>
					<onclick condition="Integer.IsGreater(Container($PARAM[id]).NumItems,1)">ActivateWindow(Videos,$ESCINFO[Skin.String($PARAM[key].path)],return)</onclick>
					<onclick condition="!Container($PARAM[id]).IsUpdating + Integer.IsLess(Container($PARAM[id]).NumItems,2)">SetProperty(rs_slot,$PARAM[key],home)</onclick>
					<onclick condition="!Container($PARAM[id]).IsUpdating + Integer.IsLess(Container($PARAM[id]).NumItems,2)">ActivateWindow(1191)</onclick>
				</item>
			</content>
		</definition>
	</include>
