		<param name="path" />
		<param name="visible" />
		<param name="key" />
		<param name="library">false</param>
		<param name="resume">false</param>
		<definition>
			<control type="group" id="$PARAM[group]">
				<height>232</height>
				<visible>$PARAM[visible]</visible>
				<control type="label">
					<left>8</left>
					<width>1520</width>
					<height>42</height>
					<font>font32_title</font>
					<textcolor>rs_text</textcolor>
