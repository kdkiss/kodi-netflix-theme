	<!-- Kodi's own library supplies the first unwatched episode in season/episode order. -->
	<include name="RS_NextEpisode">
		<definition>
			<control type="list" id="7812">
				<left>92</left>
				<top>704</top>
				<width>622</width>
				<height>100</height>
				<orientation>vertical</orientation>
				<visible>!$EXP[rs_extended_info] + String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0)</visible>
				<onup>8</onup>
				<ondown>noop</ondown>
				<onclick condition="ListItem.IsResumable">PlayMedia($ESCINFO[ListItem.FileNameAndPath],resume)</onclick>
				<onclick condition="!ListItem.IsResumable">PlayMedia($ESCINFO[ListItem.FileNameAndPath],noresume)</onclick>
				<onclick>Dialog.Close(MovieInformation)</onclick>
				<itemlayout width="622" height="100">
					<include content="RS_NextEpisodeCard">
						<param name="background" value="rs_card" />
						<param name="foreground" value="rs_text" />
					</include>
				</itemlayout>
				<focusedlayout width="622" height="100" condition="Control.HasFocus(7812)">
					<include content="RS_NextEpisodeCard">
						<param name="background" value="rs_text" />
						<param name="foreground" value="rs_bg" />
					</include>
				</focusedlayout>
				<focusedlayout width="622" height="100" condition="!Control.HasFocus(7812)">
					<include content="RS_NextEpisodeCard">
						<param name="background" value="rs_card" />
						<param name="foreground" value="rs_text" />
					</include>
				</focusedlayout>
				<content target="videos" sortby="episode" sortorder="ascending" limit="1" browse="never">videodb://tvshows/titles/$INFO[ListItem.DBID]/-1/?filter=%7B%22type%22%3A%22episodes%22%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22playcount%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%220%22%5D%7D%5D%7D%7D</content>
			</control>
		</definition>
	</include>

