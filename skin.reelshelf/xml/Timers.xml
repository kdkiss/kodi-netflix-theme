<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>autoclosevideoosd</name>
        <description>Timer to auto close the video OSD (if enabled in the skin settings)</description>
        <start reset="true">Window.IsActive(videoosd) + Skin.HasSetting(OSDAutoClose) + !String.IsEqual(window(home).Property(settingslist_content),osd) + !Window.IsActive(osdsubtitlesettings) + !Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(OSDCMSSettings)</start>
        <reset>Window.IsActive(videoosd) + !System.IdleTime(1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 1) | String.IsEqual(window(home).Property(settingslist_content),osd) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdaudiosettings) | Window.IsActive(osdvideosettings) | Window.IsActive(OSDCMSSettings)</reset>
        <stop>!Window.IsActive(videoosd) | String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 4) | !String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd),Skin.Numeric(OSDAutoCloseTime))</stop>
        <onstop>Dialog.Close(videoosd)</onstop>
    </timer>
    <timer>
        <name>1109_topbaroverlay</name>
        <description>A timer that is activated when the topbaroverlay is loaded and stops automatically after 5 seconds (or playback is resumed)</description>
        <start reset="true">[Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo)] | [Window.IsActive(1109) + [Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)]]</start>
        <reset>Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)</reset>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1109_topbaroverlay),5) | Player.Playing</stop>
    </timer>
    <timer>
        <name>rs_empty_focus</name>
        <description>Empty Home: once the browse actions have been visible for 1 s and no control has focus, focus them. Never moves focus the user already holds (rail or actions).</description>
        <start>Window.IsActive(home) + Control.IsVisible(9400) + String.IsEmpty(System.CurrentControlID)</start>
        <stop>Integer.IsGreater(Skin.TimerElapsedSecs(rs_empty_focus),0) | !Window.IsActive(home) | !Control.IsVisible(9400)</stop>
        <onstop condition="Window.IsActive(home) + Control.IsVisible(9400) + String.IsEmpty(System.CurrentControlID)">SetFocus(9400)</onstop>
    </timer>
    <timer>
        <name>rs_settle_fast</name>
        <description>Ends the Home settle window (empty shelves provisionally visible so they load) as soon as a library shelf has items and nothing is updating, min 1 s. The 3 s alarm in Home.xml is the fallback.</description>
        <start>Window.IsActive(home) + String.IsEmpty(Window(home).Property(rs_settled))</start>
        <stop>Integer.IsGreater(Skin.TimerElapsedSecs(rs_settle_fast),0) + !Container(5010).IsUpdating + !Container(5020).IsUpdating + !Container(5100).IsUpdating + !Container(5110).IsUpdating + !Container(5120).IsUpdating + !Container(5130).IsUpdating + [Integer.IsGreater(Container(5100).NumItems,0) | Integer.IsGreater(Container(5110).NumItems,0) | Integer.IsGreater(Container(5120).NumItems,0) | Integer.IsGreater(Container(5130).NumItems,0)] | !Window.IsActive(home)</stop>
        <onstop condition="Window.IsActive(home)">SetProperty(rs_settled,1,home)</onstop>
    </timer>
    <timer>
        <name>rs_relayout</name>
        <description>When the settle window ends the shelf list collapses; re-focus the focused shelf so the grouplist drops its stale scroll offset (add-on-only Home was blank until a key press).</description>
        <start>Window.IsActive(home) + !String.IsEmpty(Window(home).Property(rs_settled))</start>
        <stop>!Window.IsActive(home) | String.IsEmpty(Window(home).Property(rs_settled))</stop>
        <onstart condition="Control.HasFocus(5010)">SetFocus(5010,$INFO[Container(5010).Position])</onstart>
        <onstart condition="Control.HasFocus(5020)">SetFocus(5020,$INFO[Container(5020).Position])</onstart>
        <onstart condition="Control.HasFocus(5100)">SetFocus(5100,$INFO[Container(5100).Position])</onstart>
        <onstart condition="Control.HasFocus(5110)">SetFocus(5110,$INFO[Container(5110).Position])</onstart>
        <onstart condition="Control.HasFocus(5120)">SetFocus(5120,$INFO[Container(5120).Position])</onstart>
        <onstart condition="Control.HasFocus(5130)">SetFocus(5130,$INFO[Container(5130).Position])</onstart>
        <onstart condition="Control.HasFocus(5200)">SetFocus(5200,$INFO[Container(5200).Position])</onstart>
    </timer>
</timers>
